# Copy this file to .env and fill in your values.

# DB_ENGINE: "sqlite" for local testing (no setup needed) or "sqlserver" for production
DB_ENGINE=sqlite

# --- SQL Server settings (only needed if DB_ENGINE=sqlserver) ---
DB_SERVER=localhost
DB_NAME=HospitalDB
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server

# --- Kaggle credentials (only needed for live dataset download) ---
KAGGLE_USERNAME=
KAGGLE_KEY=
